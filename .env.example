# 机器人类型：nao / pi
EMBODIED_ROBOT=nao

# NAO（NAOqi）
NAO_IP=127.0.0.1
NAO_PORT=9559

# TonyPi（原生 JSON-RPC + MJPG）
EMBODIED_PI_IP=192.168.149.1
EMBODIED_PI_RPC_PORT=9030
EMBODIED_PI_VIDEO_PORT=8080
EMBODIED_PI_TIMEOUT_S=5

# HTTP / MCP 服务
EMBODIED_HOST=0.0.0.0
EMBODIED_PORT=19559
EMBODIED_MCP_PATH=/mcp
# EMBODIED_API_TOKEN=change-me

# 行为
EMBODIED_DRY_RUN=0
# EMBODIED_MOVEMENTS_DIR=D:/path/to/Robots/NAO/movements
EMBODIED_ACTION_TIMEOUT_S=30
EMBODIED_ASR_LANGUAGE=Chinese
EMBODIED_CAMERA_FPS=10
EMBODIED_CAMERA_RESOLUTION=1

# 逃生舱（默认关闭）
EMBODIED_ENABLE_ESCAPE_HATCH=0
# EMBODIED_ALLOWED_SERVICES=["ALMotion","ALTextToSpeech"]

EMBODIED_LOG_LEVEL=INFO
